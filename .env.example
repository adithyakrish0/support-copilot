# Copy this file to `.env` and paste your key.
# Leave LLM_API_KEY empty to run in MOCK MODE (no key needed, rule-based responses).

# --- Groq (recommended: fast, ~1,000 requests/day free, no credit card) ---
# Get a key at https://console.groq.com/keys
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# --- Fallback option: OpenRouter (20+ free models, but only 50 requests/day free) ---
# Get a key at https://openrouter.ai/keys
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
